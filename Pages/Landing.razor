@page "/"
@layout LandingLayout

<div class="landing">
    <header class="landing-header">
        <div class="landing-logo">
            <div class="logo-bars">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <button class="login-button" @onclick="GoToDashboard">
            Log in with Spotify
        </button>
    </header>

    <main class="landing-content">
        <h1 class="landing-title">Statify</h1>
    </main>

    <p class="landing-subtitle">
        Discover your Spotify listening habits anytime.<br />
        Dive into clear, beautiful insights that reveal your top artists,
        tracks, genres, and more — all in one place.
    </p>

    <footer class="landing-footer">
        no data is stored
    </footer>
</div>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    void GoToDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }
}
