@page "/"
@layout LandingLayout
@inject NavigationManager Nav

<div class="landing-hero">
    <header class="landing-nav">
        <div class="nav-bar">
            <div class="nav-logo">
                <div class="logo-bars">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>

            <button class="login-btn" @onclick="GoToDashboard">
                Log in with Spotify
            </button>
        </div>
    </header>

    <main class="hero-content">
        <div class="hero-left">
            <h1 class="hero-title">Statify</h1>
        </div>

        <div class="hero-right">
            <p class="hero-text">
                Discover your Spotify listening habits anytime.<br />
                Dive into clear, beautiful insights that reveal your top artists,
                tracks, genres, and more — all in one place.
            </p>
        </div>
    </main>

    <footer class="landing-footer">
        no data is stored
    </footer>
</div>

@code {
    void GoToDashboard()
    {
        Nav.NavigateTo("/dashboard");
    }
}
