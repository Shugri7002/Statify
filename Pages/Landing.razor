@page "/"
@layout LandingLayout

@inject NavigationManager Nav
@inject IConfiguration Config

<div class="landing">
    <header class="landing-header">
        <div class="landing-logo">
            <div class="logo-bars">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <button class="login-button" @onclick="LoginWithSpotify">
            Log in with Spotify
        </button>
    </header>

    <main class="landing-content">
        <h1 class="landing-title">Statify</h1>
    </main>

    <div class="landing-subtitle">
        <p>
            Discover your Spotify listening habits anytime.
            Dive into clear, beautiful insights that reveal your top artists,
            tracks, genres, and more — all in one place.
        </p>
    </div>

    <footer class="landing-footer">
        no data is stored
    </footer>
</div>

@code {
    void LoginWithSpotify()
    {
        var clientId    = Config["Spotify:ClientId"] ?? string.Empty;
        var redirectUri = Uri.EscapeDataString(Config["Spotify:RedirectUri"] ?? string.Empty);
        var scopes      = Uri.EscapeDataString(Config["Spotify:Scopes"] ?? string.Empty);

        var url =
            "https://accounts.spotify.com/authorize" +
            $"?client_id={clientId}" +
            "&response_type=code" +
            $"&redirect_uri={redirectUri}" +
            $"&scope={scopes}";

        Nav.NavigateTo(url, forceLoad: true);
    }
}
